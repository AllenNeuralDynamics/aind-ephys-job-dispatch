#!/usr/bin/env bash
set -ex

# This is the master script for the capsule. When you click "Reproducible Run", the code in this file will execute.
# a Reproducible Run passes no arguments, so it reads the attached AIND session; pipelines pass their own
if [ $# -eq 0 ]; then
    set -- --input aind
fi
python -u run_capsule.py "$@"
